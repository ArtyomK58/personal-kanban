{
  "tools": [
    {
      "name": "list_tasks",
      "title": "List / search tasks",
      "description": "List tasks on the board, optionally filtered by tags (projects), status and a full-text query over title, human_description and comments (agent_notes are not searched). Returns summaries ordered by column and position.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "description": "Tag (project) names, case-insensitive"
          },
          "tag_match": {
            "default": "any",
            "description": "any = at least one tag (UI semantics), all = every tag",
            "type": "string",
            "enum": [
              "any",
              "all"
            ]
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "inbox",
                  "in_progress",
                  "review",
                  "done",
                  "done_final"
                ],
                "description": "Status filter, including the hidden done_final status"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "inbox",
                    "in_progress",
                    "review",
                    "done",
                    "done_final"
                  ],
                  "description": "Status filter, including the hidden done_final status"
                }
              }
            ]
          },
          "query": {
            "description": "Full-text query, prefix matching per word",
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "description": "Only ordinary tasks (\"task\") or only epics (\"epic\")",
            "type": "string",
            "enum": [
              "task",
              "epic"
            ]
          },
          "priority": {
            "description": "Only these priorities (filter; the order stays column + manual position)",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high"
                ],
                "description": "Priority: low=Низкий, normal=Обычный, high=Высокий"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "low",
                    "normal",
                    "high"
                  ],
                  "description": "Priority: low=Низкий, normal=Обычный, high=Высокий"
                }
              }
            ]
          },
          "frozen": {
            "description": "Filter by frozen state",
            "type": "boolean"
          },
          "epic_id": {
            "description": "Tasks of this epic, or \"none\" = ordinary tasks without an epic",
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Number of an epic (a task with kind=epic)"
              },
              {
                "type": "string",
                "const": "none"
              }
            ]
          },
          "include_epic": {
            "default": false,
            "description": "With a numeric epic_id: also return the epic itself (like the UI filter)",
            "type": "boolean"
          },
          "limit": {
            "default": 200,
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_task",
      "title": "Get a task",
      "description": "Full task: title, status, kind, parent epic, tags, due date, human_description (visible to the owner), comments, and — clearly separated — agent_notes (hidden from the UI). For an epic also progress and children. Set include_agent_notes=false to skip them.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Task number, e.g. 42 for #42"
          },
          "include_agent_notes": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "create_task",
      "title": "Create a task",
      "description": "Create a task or an epic (kind='epic'). human_description is shown to the owner; agent_notes stay hidden from the UI. epic_id puts a new ordinary task into an epic. New cards go to the top of the column unless place='bottom'.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "default": "inbox",
            "type": "string",
            "enum": [
              "inbox",
              "in_progress",
              "review",
              "done"
            ],
            "description": "Destination column on the board"
          },
          "human_description": {
            "type": "string",
            "maxLength": 200000
          },
          "agent_notes": {
            "type": "string",
            "maxLength": 200000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "description": "Tag (project) names, case-insensitive"
          },
          "create_missing_tags": {
            "default": false,
            "description": "Create tags that do not exist yet",
            "type": "boolean"
          },
          "due_date": {
            "description": "YYYY-MM-DD",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "place": {
            "default": "top",
            "type": "string",
            "enum": [
              "top",
              "bottom"
            ]
          },
          "kind": {
            "default": "task",
            "type": "string",
            "enum": [
              "task",
              "epic"
            ],
            "description": "\"task\" = ordinary task, \"epic\" = epic (groups tasks)"
          },
          "epic_id": {
            "description": "Parent epic for a new ordinary task",
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Number of an epic (a task with kind=epic)"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "default": "normal",
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ],
            "description": "Priority: low=Низкий, normal=Обычный, high=Высокий"
          },
          "frozen": {
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ]
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "update_task",
      "title": "Update task fields",
      "description": "Partial update of title, status, due date, priority, frozen state, kind and parent epic (works for tasks and epics). Omitted fields keep their values. kind='epic' turns a task without an epic into an epic; kind='task' turns an epic without children back. epic_id=null detaches. Does not touch tags, human_description or agent_notes (use the dedicated tools).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Task number, e.g. 42 for #42"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "inbox",
              "in_progress",
              "review",
              "done"
            ],
            "description": "Destination column on the board"
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "task",
              "epic"
            ],
            "description": "\"task\" = ordinary task, \"epic\" = epic (groups tasks)"
          },
          "epic_id": {
            "description": "Parent epic; null = remove from its epic",
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Number of an epic (a task with kind=epic)"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ],
            "description": "Priority: low=Низкий, normal=Обычный, high=Высокий"
          },
          "frozen": {
            "description": "true freezes the card; false unfreezes it",
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "update_human_description",

# Copy to .env if you need to change defaults. No secrets live here: tokens are created by the server.
KANBAN_BIND=127.0.0.1
KANBAN_PORT=8080
# Behind an HTTPS reverse proxy:
COOKIE_SECURE=0
# comma-separated trusted proxy addresses/subnets, e.g. loopback,uniquelocal (empty = trust none)
TRUST_PROXY=

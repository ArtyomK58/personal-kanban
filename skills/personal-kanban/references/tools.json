          "mode": {
            "default": "replace",
            "type": "string",
            "enum": [
              "replace",
              "append"
            ]
          }
        },
        "required": [
          "id",
          "text"
        ]
      },
      "execution": {
        "taskSupport": "forbidden"
      }
